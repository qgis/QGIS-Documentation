msgid "[enumeration]"
msgstr "[enumeration]"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:900
#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:1203
msgid "Default: 0"
msgstr "Valore predefinito: 0"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:901
msgid "Method to apply to the gap fixing. Possible values are:"
msgstr ""
"Metodo da applicare per la correzione dello spazio vuoto. I valori possibili"
" sono:"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:903
msgid ""
"0 --- ``Add to longest shared edge``: adds the gap to the neighboring "
"feature with the longest shared edge."
msgstr ""
"0 --- ``Aggiungi al bordo condiviso più lungo``: aggiunge lo spazio vuoto "
"all'elemento adiacente con il bordo condiviso più lungo."

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:905
msgid "1 --- ``Create new feature``: creates a new feature for each gap."
msgstr ""
"1 --- ``Crea nuovo elemento``: crea un nuovo elemento per ogni spazio vuoto."

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:907
msgid ""
"2 --- ``Add to largest neighbouring area``: adds the gap to the neighboring "
"feature with the largest area."
msgstr ""
"2 --- ``Aggiungi all'area adiacente più estesa``: aggiunge lo spazio vuoto "
"all'elemento adiacente con l'area maggiore."

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:913
msgid "Default: gc_errorid"
msgstr "Valore predefinito: gc_errorid"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:916
msgid "**Field of error id**"
msgstr "**Campo dell'ID errore**"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:917
msgid "``ERROR_ID_IDX``"
msgstr "``ERROR_ID_IDX``"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:919
msgid ""
"Field storing the error ID for each gap, as output by the check algorithm."
msgstr ""
"Campo che memorizza l'ID dell'errore per ogni spazio vuoto, come generato "
"dall'algoritmo di controllo."

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:920
#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:995
msgid "**Gaps-filled layer**"
msgstr "**Layer spazi vuoti riempiti**"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:932
#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:977
msgid "**Report layer from fixing gaps**"
msgstr "**Report layer derivante dalla correzione degli spazi vuoti**"

#: ../../docs/user_manual/processing_algs/qgis/fixgeometry.rst:988
